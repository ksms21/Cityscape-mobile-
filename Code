# minicity_pyodide.py
# Pure Python game code intended to run inside Pyodide (Python in the browser).
# It creates DOM elements, a canvas, and runs the city-simulator entirely from Python.
# Requirements: run inside a page that has loaded Pyodide (https://pyodide.org/) and then execute this script.

from js import document, window, console, Uint8Array, JSON
from math import floor, ceil
import time
import json

# ---- Configuration ----
MAP_W = 80
MAP_H = 50
BASE_TILE_PX = 28  # base tile size (will scale)
SIM_TICK_MS = 800  # simulation tick in ms (game time update)
INITIAL_MONEY = 8000

# Tile enums
EMPTY = 0
ROAD = 1
RES = 2
COM = 3
IND = 4
PARK = 5
POLICE = 6
FIRE = 7
TILE_NAMES = {
    EMPTY: "Empty", ROAD: "Road", RES: "Residential", COM: "Commercial",
    IND: "Industrial", PARK: "Park", POLICE: "Police", FIRE: "Fire"
}

# Costs and stats per tile type (cost to build)
BUILD_COST = {
    ROAD: 5,
    RES: 60,
    COM: 90,
    IND: 80,
    PARK: 30,
    POLICE: 200,
    FIRE: 200
}
# base pop/job capacities
CAPACITY = {
    RES: 10,
    COM: -5,   # jobs created (negative to indicate jobs)
    IND: -8
}

# ---- State ----
map_tiles = [EMPTY] * (MAP_W * MAP_H)
building_level = [0] * (MAP_W * MAP_H)  # small growth level for residential/commercial
state = {
    "money": INITIAL_MONEY,
    "population": 0,
    "jobs": 0,
    "day": 0,
    "happiness": 0.8
}

# View transform
view = {
    "x": MAP_W / 2,
    "y": MAP_H / 2,
    "scale": 1.0,
    "offset_x": 0.0,
    "offset_y": 0.0
}

# Interaction
current_tool = ROAD
is_panning = False
last_pointer = None

# DOM creation helpers (pure Python -> DOM)
def create(elem_type, props=None, parent=None):
    el = document.createElement(elem_type)
    if props:
        for k, v in props.items():
            if k == "style":
                for sk, sv in v.items():
                    el.style[sk] = sv
            elif k == "text":
                el.textContent = v
            else:
                el.setAttribute(k, v)
    if parent is None:
        document.body.appendChild(el)
    else:
        parent.appendChild(el)
    return el

