add_button_row([("Park", PARK), ("Police", POLICE), ("Fire", FIRE), ("Eraser", EMPTY)])

# Utility functions
def idx(x, y):
    return int(y) * MAP_W + int(x)

def in_map(x, y):
    return 0 <= x < MAP_W and 0 <= y < MAP_H

def set_tile(x, y, tile):
    if not in_map(x, y): return False
    i = idx(x,y)
    old = map_tiles[i]
    cost = BUILD_COST.get(tile, 0)
    global state
    # Erasing refunds a small portion
    if tile == EMPTY:
        if old != EMPTY:
            refund = max(1, int(BUILD_COST.get(old, 0) * 0.3))
            state['money'] += refund
            map_tiles[i] = EMPTY
            building_level[i] = 0
            return True
        return False
    # Building
    if old != EMPTY:
        # avoid placing on non-empty (except overwrite allowed if eraser)
        return False
    if state['money'] < cost:
        # not enough money
        return False
    state['money'] -= cost
    map_tiles[i] = tile
    if tile in (RES, COM, IND):
        building_level[i] = 1
    else:
        building_level[i] = 0
    return True

# Rendering
def resize_canvas():
    w = window.innerWidth
    h = window.innerHeight
    canvas.width = int(w)
    canvas.height = int(h)
    canvas.style.width = f"{w}px"
    canvas.style.height = f"{h}px"

resize_canvas()
window.addEventListener("resize", lambda ev: resize_canvas())

def world_to_screen(wx, wy):
    tile_px = BASE_TILE_PX * view['scale']
    cx = canvas.width / 2
    cy = canvas.height / 2
    sx = cx + (wx - view['x']) * tile_px + view['offset_x']
    sy = cy + (wy - view['y']) * tile_px + view['offset_y']
    return sx, sy, tile_px

def screen_to_world(sx, sy):
    tile_px = BASE_TILE_PX * view['scale']
    cx = canvas.width / 2
    cy = canvas.height / 2
    wx = view['x'] + (sx - cx - view['offset_x']) / tile_px
    wy = view['y'] + (sy - cy - view['offset_y']) / tile_px
    return wx, wy

def draw():
    ctx.fillStyle = "#07111a"
    ctx.fillRect(0,0,canvas.width,canvas.height)
    # visible bounds
    tile_px = BASE_TILE_PX * view['scale']
    cx = canvas.width / 2
    cy = canvas.height / 2
    left = int(floor((0 - cx - view['offset_x']) / tile_px + view['x'])) - 2
    top = int(floor((0 - cy - view['offset_y']) / tile_px + view['y'])) - 2
    right = int(ceil((canvas.width - cx - view['offset_x']) / tile_px + view['x'])) + 2
    bottom = int(ceil((canvas.height - cy - view['offset_y']) / tile_px + view['y'])) + 2

    for y in range(top, bottom+1):
        for x in range(left, right+1):
            if not in_map(x,y): continue
            sx, sy, tp = world_to_screen(x, y)
            # floor
            ctx.fillStyle = "#0f2630"
            ctx.fillRect(sx, sy, tp-1, tp-1)
            t = map_tiles[idx(x,y)]
            # draw based on tile
            if t == ROAD:
                ctx.fillStyle = "#6f777b"
                ctx.fillRect(sx+tp*0.12, sy+tp*0.42, tp*0.76, tp*0.16)
            elif t == RES:
                # rectangle housing with greenish
                level = building_level[idx(x,y)]
                shade = 120 + min(80, level*20)
                ctx.fillStyle = f"rgb(90,{shade},90)"
                ctx.fillRect(sx+tp*0.08, sy+tp*0.12, tp*0.84, tp*0.76)
            elif t == COM:
                level = building_level[idx(x,y)]
                shade = 120 + min(80, level*30)
                ctx.fillStyle = f"rgb({shade},120,120)"
                ctx.fillRect(sx+tp*0.06, sy+tp*0.08, tp*0.88, tp*0.84)
            elif t == IND:
                ctx.fillStyle = "#9a8570"
                ctx.fillRect(sx+tp*0.06, sy+tp*0.08, tp*0.88, tp*0.84)
            elif t == PARK:
                ctx.fillStyle = "#2f8a3e"
                ctx.fillRect(sx+tp*0.06, sy+tp*0.06, tp*0.88, tp*0.88)
            elif t == POLICE:
                ctx.fillStyle = "#2b6b9f"
                ctx.fillRect(sx+tp*0.12, sy+tp*0.12, tp*0.76, tp*0.76)
            elif t == FIRE:
                ctx.fillStyle = "#9f3b2b"
                ctx.fillRect(sx+tp*0.12, sy+tp*0.12, tp*0.76, tp*0.76)

    # HUD overlays (money/pop/day)
    ctx.fillStyle = "rgba(255,255,255,0.06)"
    ctx.fillRect(8,8,200,56)
    ctx.fillStyle = "#e6eef6"
    ctx.font = "14px sans-serif"
    ctx.fillText(f"Money: ${state['money']}", 16, 28)
    ctx.fillText(f"Population: {state['population']}", 16, 46)
    ctx.fillText(f"Day: {state['day']}", 120, 28)
    ctx.fillText(f"Jobs: {state['jobs']}", 120, 46)

# Interaction handlers
def handle_place_at_screen(sx, sy):
    wx, wy = screen_to_world(sx, sy)
    gx = int(floor(wx + 0.5))
    gy = int(floor(wy + 0.5))
    if not in_map(gx, gy):
        return
    placed = set_tile(gx, gy, current_tool)
    if placed:
        # immediate visual feedback and update labels
        update_labels()

def pointer_down(ev):
    global is_panning, last_pointer
    ev.preventDefault()
    is_panning = True
    last_pointer = (ev.clientX, ev.clientY)
    # if quick tap, place
    # to detect tap vs pan, we'll handle in pointer_up

def pointer_move(ev):
    global last_pointer, view
    if not is_panning or last_pointer is None:
        return
    dx = ev.clientX - last_pointer[0]
    dy = ev.clientY - last_pointer[1]
    view['offset_x'] += dx
    view['offset_y'] += dy
    last_pointer = (ev.clientX, ev.clientY)

def pointer_up(ev):
    global is_panning, last_pointer
    ev.preventDefault()
    # if pointer didn't move much -> treat as tap -> place
    if last_pointer is not None:
        dx = ev.clientX - last_pointer[0]
        dy = ev.clientY - last_pointer[1]
        dist2 = dx*dx + dy*dy
        if dist2 < 64:  # small movement -> tap
            handle_place_at_screen(ev.clientX, ev.clientY)
    is_panning = False
    last_pointer = None

# Attach events
canvas.addEventListener("pointerdown", lambda ev: pointer_down(ev), False)
canvas.addEventListener("pointermove", lambda ev: pointer_move(ev), False)
canvas.addEventListener("pointerup", lambda ev: pointer_up(ev), False)
canvas.addEventListener("pointercancel", lambda ev: pointer_up(ev), False)
canvas.addEventListener("pointerout", lambda ev: pointer_up(ev), False)
canvas.addEventListener("pointerleave", lambda ev: pointer_up(ev), False)

# Wheel zoom for desktop fallback
def on_wheel(ev):
    ev.preventDefault()
    delta = ev.deltaY
    if delta > 0:
        view['scale'] *= 0.95
    else:
        view['scale'] *= 1.05
    view['scale'] = max(0.4, min(2.2, view['scale']))
canvas.addEventListener("wheel", lambda ev: on_wheel(ev), False)

# Touch pinch zoom (basic) - using gesture events is complex; many mobile browsers don't send wheel
# We'll support double-tap to zoom in/out.
last_tap_time = 0
def on_touch_end(ev):
    global last_tap_time
    t = int(time.time() * 1000)
    if t - last_tap_time < 350:
        # double-tap detected -> zoom in centered at tap
        x = ev.changedTouches.item(0).clientX
        y = ev.changedTouches.item(0).clientY
        view['scale'] = min(2.2, view['scale'] * 1.6)
    last_tap_time = t

# Attempt to attach touchend if available in env
try:
    canvas.addEventListener("touchend", lambda ev: on_touch_end(ev), False)
except Exception:
    pass

# Simulation tick
_last_sim = time.time() * 1000
_last_frame = time.time() * 1000
def sim_tick():
    # run one simulation tick: population growth based on residential connected to roads and jobs
    # For simplicity: each RES tile gives capacity; if adjacent to road, it grows faster.
    pop = 0
    jobs = 0
    # compute service coverage (police/fire) influence
    police_positions = []
    fire_positions = []
    for y in range(MAP_H):
        for x in range(MAP_W):
            t = map_tiles[idx(x,y)]
            if t == POLICE:
                police_positions.append((x,y))
            if t == FIRE:
                fire_positions.append((x,y))

    coverage_police = set()
    coverage_fire = set()
    # simple coverage radius 5
    for (px,py) in police_positions:
        for oy in range(py-5, py+6):
            for ox in range(px-5, px+6):
                if in_map(ox,oy):
                    coverage_police.add(idx(ox,oy))
    for (fx,fy) in fire_positions:
        for oy in range(fy-4, fy+5):
            for ox in range(fx-4, fx+5):
                if in_map(ox,ox):
                    coverage_fire.add(idx(ox,oy))

    # compute growth and jobs
    for y in range(MAP_H):
        for x in range(MAP_W):
            i = idx(x,y)
            t = map_tiles[i]
            if t == RES:
                # if adjacent to road -> grows
                adj_road = False
                for dx in (-1,0,1):
                    for dy in (-1,0,1):
                        nx = x+dx; ny = y+dy
                        if in_map(nx,ny) and map_tiles[idx(nx,ny)] == ROAD:
                            adj_road = True
                if adj_road:
                    # growth chance -> increase level up to 5
                    if building_level[i] < 5 and (time.time() * 1000) % 1000 < 500:
                        building_level[i] += 1
                pop += building_level[i] * 2  # each level yields pop
            elif t == COM:
                # commercial creates jobs proportional to level
                jobs += max(1, building_level[i]) * 3
            elif t == IND:
                jobs += max(1, building_level[i]) * 4

    # adjust happiness with parks and services (simple)
    park_count = sum(1 for t in map_tiles if t == PARK)
    service_bonus = min(0.25, (len(police_positions) + len(fire_positions)) * 0.05)
    happiness = 0.6 + min(0.3, park_count * 0.01) + service_bonus

    # update state slowly
    state['population'] = int(pop)
    state['jobs'] = int(jobs)
    state['happiness'] = happiness
    state['day'] += 1
    # daily tax income
    income = int(state['population'] * 0.2 + state['jobs'] * 0.05 + state['happiness'] * 2)
    state['money'] += income

    update_labels()

# Update labels
def update_labels():
    money_label.textContent = f"Money: ${state['money']}"
    pop_label.textContent = f"Pop: {state['population']}"
    day_label.textContent = f"Day: {state['day']}"
    tool_label.textContent = "Tool: " + TILE_NAMES.get(current_tool, "Unknown")

# Save/load using localStorage
def save_state(name="autosave"):
    try:
        payload = {
            "map": map_tiles,
            "building_level": building_level,
            "state": state,
            "view": view
        }
        window.localStorage.setItem("minicity_save_" + name, JSON.stringify(payload))
        console.log("Saved:", name)
    except Exception as e:
        console.error("Save failed", e)

def load_state(name="autosave"):
    try:
        raw = window.localStorage.getItem("minicity_save_" + name)
        if not raw:
            console.warn("No save found:", name)
            return False
        payload = json.loads(raw)
        # restore
        global map_tiles, building_level, state, view
        map_tiles = list(payload.get("map", map_tiles))
        building_level = list(payload.get("building_level", building_level))
        state = payload.get("state", state)
        view = payload.get("view", view)
        update_labels()
        console.log("Loaded:", name)
        return True
    except Exception as e:
        console.error("Load failed", e)
        return False

# Quick save/load buttons
save_btn = create("button", {"text":"Save (local)", "style":{"padding":"6px","borderRadius":"6px","marginTop":"6px","background":"#183240"}}, parent=panel)
load_btn = create("button", {"text":"Load (local)", "style":{"padding":"6px","borderRadius":"6px","background":"#1b2b20"}}, parent=panel)
def on_save(ev):
    save_state("autosave")
def on_load(ev):
    load_state("autosave")
save_btn.addEventListener("click", lambda ev: on_save(ev), False)
load_btn.addEventListener("click", lambda ev: on_load(ev), False)

# Game loop
running = True
last_sim_time = time.time() * 1000

def frame(ts):
    # ts is DOMHighResTimeStamp passed by requestAnimationFrame (ignored)
    global last_sim_time
    now = time.time() * 1000
    # Simulation tick every SIM_TICK_MS
    if now - last_sim_time >= SIM_TICK_MS:
        try:
            sim_tick()
        except Exception as e:
            console.error("Sim error", e)
        last_sim_time = now
    try:
        draw()
    except Exception as e:
        console.error("Draw error", e)
    if running:
        window.requestAnimationFrame(frame)

# Start loop
update_labels()
window.requestAnimationFrame(frame)

# Expose some functions to window for debugging
window.minicity = {
    "save_state": save_state,
    "load_state": load_state,
    "get_state": lambda : JSON.parse(JSON.stringify(state)),
